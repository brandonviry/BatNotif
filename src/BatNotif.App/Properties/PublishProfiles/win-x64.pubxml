<?xml version="1.0" encoding="utf-8"?>
<!--
  Publication de BatNotif en un seul .exe autonome (research R11, constitution « Distribution »).
  Utilisé par scripts/publish.ps1, qui produit deux versions en passant EnableCompressionInSingleFile :
    - standard : false (≈ 160 Mo disque, ≈ 133 Mo RAM) ;
    - compact  : true  (≈ 69 Mo disque, ≈ 194 Mo RAM).
  Ces propriétés ne s'appliquent qu'à la publication, pas aux builds Debug / Release habituels.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF embarque des bibliothèques natives : elles sont extraites au premier lancement. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Par défaut : version standard (non compressée). publish.ps1 passe true pour la version compact. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Symboles intégrés aux DLL via Directory.Build.props (DebugType=embedded en Release) : aucun .pdb livré. -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
